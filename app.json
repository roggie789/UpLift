{
  "expo": {
    "name": "UpLift",
    "slug": "uplift",
    "version": "0.1.0",
    "scheme": "uplift",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1B4DB1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.uplift.app"
    },
    "android": {
      "package": "com.uplift.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B4DB1"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
